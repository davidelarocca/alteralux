# swiftformat config generated by swift-harness
--swiftversion 6.2
--indent 4
--maxwidth 160
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--self remove
--importgrouping testable-bottom
--commas always
--exclude .build,DerivedData,build,engine,apple/SpektrafilmKit/Sources/SpektrafilmEngine/Generated,apple/SpektrafilmKit/Tests/SpektrafilmUITests/LayoutContract.swift,apple/SpektrafilmKit/Tests/SpektrafilmUITests/Screenshot.swift,apple/SpektrafilmKit/Tests/SpektrafilmUITests/Snapshot.swift,apple/SpektrafilmKit/Tests/SpektrafilmUITests/KeyboardCheck.swift
--disable swiftTestingTestCaseNames
