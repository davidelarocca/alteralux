# swiftformat config generated by swift-harness
--swiftversion 6.2
--indent 4
--maxwidth 160
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--self remove
--importgrouping testable-bottom
--commas always
--exclude .build,DerivedData,build,engine,apple/AlteraluxKit/Sources/AlteraluxEngine/Generated,apple/AlteraluxKit/Tests/AlteraluxUITests/LayoutContract.swift,apple/AlteraluxKit/Tests/AlteraluxUITests/Screenshot.swift,apple/AlteraluxKit/Tests/AlteraluxUITests/Snapshot.swift,apple/AlteraluxKit/Tests/AlteraluxUITests/KeyboardCheck.swift
--disable swiftTestingTestCaseNames
