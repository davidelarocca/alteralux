<?xml version="1.0"?>
<!DOCTYPE lensdatabase SYSTEM "lensfun-database.dtd">
<!-- A few entries in lensfun's format, written for the tests. -->
<lensdatabase version="2">

    <mount>
        <name>Canon EF</name>
        <compat>Generic</compat>
    </mount>

    <camera>
        <maker>Canon</maker>
        <model>Canon EOS 5D Mark IV</model>
        <mount>Canon EF</mount>
        <cropfactor>1.0</cropfactor>
    </camera>

    <camera>
        <maker>Nikon Corporation</maker>
        <model>NIKON D850</model>
        <mount>Nikon F AF</mount>
        <cropfactor>1.0</cropfactor>
    </camera>

    <lens>
        <maker>Canon</maker>
        <model>Canon EF 50mm f/1.8 II</model>
        <mount>Canon EF</mount>
        <cropfactor>1.0</cropfactor>
        <calibration>
            <distortion model="poly3" focal="50" k1="-0.0210"/>
            <vignetting model="pa" focal="50" aperture="1.8" distance="1000" k1="-0.8" k2="0.6" k3="-0.2"/>
        </calibration>
    </lens>

    <!-- Poly5 distortion and linear lateral color, at one focal length. -->
    <lens>
        <maker>Canon</maker>
        <model>Canon EF 35mm f/2 IS</model>
        <mount>Canon EF</mount>
        <cropfactor>1.0</cropfactor>
        <aspect-ratio>3:2</aspect-ratio>
        <center x="0.01" y="-0.02"/>
        <calibration>
            <distortion model="poly5" focal="35" k1="0.0100" k2="-0.0050"/>
            <tca model="linear" focal="35" kr="1.0002" kb="0.9997"/>
        </calibration>
    </lens>

    <lens>
        <maker>Nikon</maker>
        <model>Nikkor AF-S 24-70mm f/2.8G ED</model>
        <mount>Nikon F AF</mount>
        <cropfactor>1.0</cropfactor>
        <calibration>
            <distortion model="ptlens" focal="24" a="0.0100" b="-0.0300" c="0.0100"/>
            <distortion model="ptlens" focal="70" a="0.0010" b="0.0100" c="-0.0100"/>
        </calibration>
    </lens>

</lensdatabase>
