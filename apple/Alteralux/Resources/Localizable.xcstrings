    "Auto %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto %@"
          }
        }
      }
    },
    "Changed" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modificata"
          }
        }
      }
    },
    "Puts this section's controls back to how they start" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riporta i controlli di questa sezione ai valori iniziali"
          }
        }
      }
    },
    "Makes the brightest tones of the scan pure white, from this level up: lower brightens the scan." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rende bianco puro i toni più chiari della scansione, da questo livello in su: più basso schiarisce la scansione."
          }
        }
      }
    },
    "Makes the deepest tones of the scan pure black, from this level down: higher deepens the shadows." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rende nero puro i toni più scuri della scansione, da questo livello in giù: più alto scurisce le ombre."
          }
        }
      }
    },
    "Off: switch Glare on to shape it." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spenta: accendi Luce parassita per regolarla."
          }
        }
      }
    },
    "Off: switch the diffusion filter on to choose its kind." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spento: accendi il filtro di diffusione per sceglierne il tipo."
          }
