<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets Finder offer the app in "Open With" for photos. The app only
	     reads originals; it never modifies them. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Photo</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.camera-raw-image</string>
				<string>public.tiff</string>
				<string>public.jpeg</string>
				<string>public.heic</string>
				<string>public.png</string>
				<string>com.ilm.openexr-image</string>
			</array>
		</dict>
	</array>
	<!-- "Develop with alteralux…" in the Finder's right-click menu: the
	     selected photos are sent to the app, which asks for the workflow to
	     develop them with. A menu entry only: no extension, no entitlement.
	     The title is translated in ServicesMenu.xcstrings. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Develop with alteralux…</string>
			</dict>
			<key>NSMessage</key>
			<string>developWithWorkflow</string>
			<key>NSPortName</key>
			<string>Alteralux</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.camera-raw-image</string>
				<string>public.tiff</string>
				<string>public.jpeg</string>
				<string>public.heic</string>
				<string>public.png</string>
				<string>com.ilm.openexr-image</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
