// Code signing and runtime protection of the app.
//
// Kept in a tracked file (the Xcode project is generated and not committed), so a
// change to these settings shows up in review. Never relax them to make
// something work: see CLAUDE.md.

// "Sign to Run Locally": no Apple developer account is needed to build.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

// App Sandbox and its permissions are declared in the entitlements file.
CODE_SIGN_ENTITLEMENTS = Alteralux/Alteralux.entitlements
ENABLE_HARDENED_RUNTIME = YES
