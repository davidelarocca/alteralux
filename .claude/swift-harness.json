{
  "format": "swiftformat",
  "lint": "swiftlint",
  "lintBlocking": false,
  "verify": {
    "enabled": true,
    "command": "scripts/verify.sh fast",
    "maxAttempts": 3,
    "inputs": ["scripts/bootstrap.sh", "scripts/build-engine.sh"],
    "watch": ["engine/"]
  },
  "protectedPaths": [
    "apple/Alteralux/Alteralux.entitlements",
    "apple/Alteralux/Info.plist",
    "apple/Alteralux/Signing.xcconfig"
  ],
  "registry": {
    "sources": ["apple/DesignSystem/Sources"]
  },
  "guardPbxproj": true,
  "snapshots": {
    "approveNew": true,
    "pending": "collect"
  }
}
